x = np.arange(1,5,1)
x1=x.cumsum()
x2=x.cumprod()
plt.subplots(2,3,sharex=True, sharey=False)

plt.plot(x1,x2)
plt.show()

x = np.array([0,1,2,3,4])
y = np.array([5,6,7,8,9])
plt.xticks(ticks=x, labels=['One',"Two",'Three','Four','Five'])
plt.yticks(ticks=y, labels=['Six',"Seven",'Eight','Nine','Ten'])
plt.plot(x, color="blue",linestyle='--',marker='o',markerfacecolor='red',markeredgecolor='orange',markersize=10,label="line1")
plt.plot(y, color="green",linestyle='-',marker='o',markerfacecolor='red',markeredgecolor='orange',markersize=10,label="line2")

plt.legend(loc='upper left')
plt.title("Illustration of plot features")
plt.xlabel("X-axis Label")
plt.ylabel("Y-axis Label")
plt.show()

